# /etc/mysql/conf.d/charset.cnf 로 마운트됨.
# docker-entrypoint-initdb.d가 02-data.sql을 실행할 때 사용하는 mysql 클라이언트도
# 이 설정을 읽는다 — [client]/[mysql] 섹션이 없으면 클라이언트가 기본값(latin1)으로 접속해서
# UTF-8로 저장된 한글이 이중 인코딩(mojibake)된다.

[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4

[mysqld]
character-set-server=utf8mb4
collation-server=utf8mb4_general_ci
